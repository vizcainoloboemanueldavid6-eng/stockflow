{
  "name": "stockflow",
  "version": "1.0.0",
  "private": true,
  "description": "StockFlow - a full-stack inventory web app for small businesses: products, stock movements, suppliers and reports.",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.mjs",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:generate": "node scripts/db.mjs generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "node scripts/db.mjs push",
    "db:seed": "node scripts/db.mjs seed",
    "db:reset-demo": "node scripts/db.mjs reset-demo",
    "db:local": "node scripts/db-local.mjs",
    "db:local:stop": "node scripts/db-local.mjs stop",
    "db:sqlite": "node scripts/db.mjs sqlite",
    "postinstall": "node scripts/postinstall.mjs",
    "shots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tanstack/react-table": "8.21.3",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.48.0",
    "next": "15.5.26",
    "next-auth": "5.0.0-beta.32",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "2.6.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.57.0",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.1",
    "embedded-postgres": "16.14.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.26",
    "postcss": "8.5.28",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "1.0.7",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 121",
    "safari >= 16.4",
    "not dead"
  ],
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "next": {
      "postcss": "8.5.28"
    }
  },
  "allowScripts": {
    "@embedded-postgres/darwin-arm64": true,
    "@embedded-postgres/darwin-x64": true,
    "@embedded-postgres/linux-arm64": true,
    "@embedded-postgres/linux-x64": true,
    "@embedded-postgres/windows-x64": true,
    "@prisma/client": true,
    "@prisma/engines": true,
    "esbuild": true,
    "prisma": true,
    "unrs-resolver": true
  }
}
