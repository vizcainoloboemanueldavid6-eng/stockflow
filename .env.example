# StockFlow environment variables.
# Copy to `.env` (the Prisma CLI and the npm scripts read `.env`; Next.js reads it too).
# On Vercel, set the same keys in Project Settings -> Environment Variables.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# "postgresql" (default) or "sqlite".
#   postgresql - production (Neon/Supabase) and local development against Postgres.
#   sqlite     - zero-setup mode: `npm run db:sqlite` builds prisma/sqlite/stockflow.db.
#                On Vercel it gives a working public demo without any database service:
#                the seeded file ships with the build and each server instance works on
#                its own copy, so data resets on every cold start.
# The value is baked in at build time (next.config.ts). After switching locally, run
# `npm run db:generate` (Postgres) or `npm run db:sqlite` (SQLite) - the Prisma Client
# is generated for one provider at a time.
DATABASE_PROVIDER="postgresql"

# PostgreSQL connection string (ignored in sqlite mode).
#   npm run db:local (embedded Postgres, no Docker):
#     postgresql://postgres:postgres@localhost:54329/stockflow
#   docker compose up -d:
#     postgresql://stockflow:stockflow@localhost:5432/stockflow
#   Neon: use the *pooled* connection string and keep ?sslmode=require, e.g.
#     postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/stockflow"

# Direct (non-pooled) connection string. Only the Vercel build uses it, for
# `prisma migrate deploy` and the first-run seed (migrations need a direct session).
# Neon's Vercel integration sets it automatically; with a manual Neon setup paste the
# connection string whose host has no "-pooler". Not needed locally.
# DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# Authentication (Auth.js v5)
# ---------------------------------------------------------------------------

# Secret used to sign and encrypt session tokens. REQUIRED in production.
# Generate one with:  npx auth secret   or   openssl rand -base64 33
AUTH_SECRET="replace-me-with-a-long-random-string"

# Trust the Host header (needed behind proxies and with `next start` locally).
# Vercel is detected automatically; leaving this on is harmless there.
AUTH_TRUST_HOST="true"

# Self-service sign-up at /register (new accounts are Staff). Set to "false" to close it.
ALLOW_REGISTRATION="true"

# Self-hosting behind a reverse proxy (nginx, Caddy, Traefik) that appends the client
# address to X-Forwarded-For: set to "true" so the sign-in and registration limits count
# per visitor. Leave unset otherwise - a client can write that header itself, so without a
# trusted proxy the limits count per email (sign-in) and per server (registration).
# Not needed on Vercel, whose edge network sets the header.
# TRUST_PROXY="true"

# ---------------------------------------------------------------------------
# Demo account and seed data
# ---------------------------------------------------------------------------

# Public demo mode: the "Try the demo" button, the daily demo reset and the three seeded
# accounts with the passwords published in the README (locked: nobody can delete them or
# change their role, password or email). Set to "false" for a real business deployment:
# no button, /api/cron/reset-demo does nothing, the seed creates no demo account (and
# removes one left from before), a Demo-role account cannot sign in, and the seed refuses
# to run until SEED_ADMIN_PASSWORD and SEED_STAFF_PASSWORD are set.
DEMO_ENABLED="true"

# Credentials of the shared demo account (created by the seed while the demo is on).
# Optional - these are the defaults. They are public on purpose.
DEMO_EMAIL="demo@stockflow.test"
DEMO_PASSWORD="Demo#2026"

# Seeded admin and staff accounts. REQUIRED with DEMO_ENABLED=false, and set BEFORE the
# first seed of a production database (on Vercel: before the first deploy). Defaults
# (demo mode only):
#   admin@stockflow.test / Admin#2026   and   staff@stockflow.test / Staff#2026
# SEED_ADMIN_EMAIL=""
# SEED_ADMIN_PASSWORD=""
# SEED_STAFF_EMAIL=""
# SEED_STAFF_PASSWORD=""

# ---------------------------------------------------------------------------
# Reporting
# ---------------------------------------------------------------------------

# Time zone of the business (IANA name). Decides what "today" means on the dashboard,
# the 30 daily chart buckets, the history date filters and the dates in CSV files.
# Optional: when empty or invalid the server's own zone is used - on Vercel that is UTC,
# so set it there. Examples: America/Bogota, America/New_York, Europe/Madrid.
APP_TIME_ZONE=""

# ---------------------------------------------------------------------------
# Scheduled jobs
# ---------------------------------------------------------------------------

# Protects GET /api/cron/reset-demo (vercel.json runs it daily at 04:00 UTC).
# Vercel sends it automatically as "Authorization: Bearer <CRON_SECRET>".
# Without it the endpoint answers 503 and never resets anything.
# Generate one with:  openssl rand -hex 32
CRON_SECRET="replace-me-with-another-long-random-string"
